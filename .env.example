# Database connection string. SQLite for local dev, PostgreSQL for production.
DATABASE_URL=sqlite:///./unstuck.db
# DATABASE_URL=postgresql://user:password@localhost:5432/unstuckinator

# JWT signing secret. MUST be changed for production — use a long random string.
JWT_SECRET=dev-secret-change-in-production

# JWT token expiry in minutes (default: 1440 = 24 hours).
JWT_EXPIRE_MINUTES=1440

# Public hostname for Traefik routing (used in docker-compose labels).
DEPLOY_HOST=unstuckinator.machomelab.com
